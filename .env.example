# Copy to .env or export before `npm start`. All values are optional.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Demo credits for new sessions, in cents (100000 = €1,000.00)
STARTING_BALANCE=100000
SESSION_IDLE_MINUTES=120
# Comma-separated origins allowed to call the API cross-origin (unset = same-origin only)
# CORS_ORIGIN=http://localhost:5173
# QA forced outcomes (/api/spin "cheat" field). NEVER enable in production.
ENABLE_CHEATS=false
